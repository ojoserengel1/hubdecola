{
  "name": "decolaweb-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Hub DecolaWeb - Área do Cliente e Admin",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@decolaweb/web",
    "dev:api": "npm run dev --workspace=@decolaweb/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@decolaweb/web",
    "build:api": "npm run build --workspace=@decolaweb/api",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.2"
  }
}
